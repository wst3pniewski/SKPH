{% extends "base.jinja" %}

{% block title %}{{ _("Charity Campaigns") }}{% endblock %}

{% block content %}
<div class="container mt-2">
    <h1>{{ _("Charity Campaigns") }}</h1>

    <div class="row">
        {% for campaign in charity_campaigns %}
        <div class="col-md-4 mb-4">
            <div class="card h-100 rounded-3 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">{{ campaign.name }}</h5>
                    <p class="card-text">{{ campaign.description }}</p>
                    <div class="mt-auto d-flex justify-content-start">
                        <a href="{{ url_for('organization.view_authorities', authorities_id=campaign.authority.id) }}"
                            class="btn btn-primary btn-sm me-2">{{ _("View Authority") }}</a>
                        <a href="{{ url_for('organization.list_signed_organizations', charity_campaign_id=campaign.id) }}"
                            class="btn btn-primary btn-sm">{{ _("View Campaigns") }}</a>
                    </div>
                </div>
                <div class="card-footer">
                    {% if campaign.is_active %}
                    <span class="badge text-bg-success">{{ _("Active") }}</span>
                    {% else %}
                    <span class="badge text-bg-warning">{{ _("Inactive") }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<nav aria-label="Page navigation example">
    <ul class="pagination justify-content-center">
        {% if pagination.has_prev %}
        <li class="page-item">
            <a class="page-link" href="{{ url_for('organization.list_charity_campaigns', page=1) }}">First</a>
        </li>
        <li class="page-item">
            <a class="page-link"
                href="{{ url_for('organization.list_charity_campaigns', page=pagination.prev_num) }}">Previous</a>
        </li>
        {% else %}
        <li class="page-item disabled">
            <a class="page-link" href="#">First</a>
        </li>
        <li class="page-item disabled">
            <a class="page-link" href="#">Previous</a>
        </li>
        {% endif %}
        {% for page_num in pagination.iter_pages(left_edge=2, right_edge=2, left_current=2, right_current=2) %}
        {% if page_num %}
        {% if page_num == pagination.page %}
        <li class="page-item active">
            <a class="page-link" href="#">{{ page_num }}</a>
        </li>
        {% else %}
        <li class="page-item">
            <a class="page-link" href="{{ url_for('organization.list_charity_campaigns', page=page_num) }}">{{ page_num
                }}</a>
        </li>
        {% endif %}
        {% else %}
        <li class="page-item disabled">
            <a class="page-link" href="#">...</a>
        </li>
        {% endif %}
        {% endfor %}
        {% if pagination.has_next %}
        <li class="page-item">
            <a class="page-link"
                href="{{ url_for('organization.list_charity_campaigns', page=pagination.next_num) }}">Next</a>
        </li>
        <li class="page-item">
            <a class="page-link"
                href="{{ url_for('organization.list_charity_campaigns', page=pagination.pages) }}">Last</a>
        </li>
        {% else %}
        <li class="page-item disabled">
            <a class="page-link" href="#">Next</a>
        </li>
        <li class="page-item disabled">
            <a class="page-link" href="#">Last</a>
        </li>
        {% endif %}
    </ul>
</nav>
{% endblock %}