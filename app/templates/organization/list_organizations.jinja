{% extends "base.jinja" %}

{% block title %}{{ _("Organizations") }}{% endblock %}

{% block content %}
<div class="container mt-2">
    <h1>{{ _("Organizations") }}</h1>

    <div class="row">
        {% for organization in organizations %}
        <div class="col-md-4 mb-4">
            <div class="card h-100 rounded-3 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title mb-4">{{ organization.organization_name }}</h5>
                        <img src="{{ url_for('static', filename='uploads/' ~ (organization.user.profile_picture or 'base_profile_picture.jpg')) }}"
                            alt="Profile Picture" class="rounded-circle" width="40" height="40">
                    </div>
                    <p class="card-text">{{ organization.description }}</p>
                    <div class="mt-auto d-flex justify-content-start">
                        <a href="{{ url_for('organization.view_organization', organization_id=organization.id) }}"
                            class="btn btn-primary btn-sm">{{ _("View Organization") }}</a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center">
            {% if pagination.has_prev %}
            <li class="page-item">
                <a class="page-link" href="{{ url_for('organization.list_organizations', page=1) }}">First</a>
            </li>
            <li class="page-item">
                <a class="page-link"
                    href="{{ url_for('organization.list_organizations', page=pagination.prev_num) }}">Previous</a>
            </li>
            {% else %}
            <li class="page-item disabled">
                <a class="page-link" href="#">First</a>
            </li>
            <li class="page-item disabled">
                <a class="page-link" href="#">Previous</a>
            </li>
            {% endif %}
            {% for page_num in pagination.iter_pages(left_edge=2, right_edge=2, left_current=2, right_current=2) %}
            {% if page_num %}
            {% if page_num == pagination.page %}
            <li class="page-item active">
                <a class="page-link" href="#">{{ page_num }}</a>
            </li>
            {% else %}
            <li class="page-item">
                <a class="page-link" href="{{ url_for('organization.list_organizations', page=page_num) }}">{{ page_num
                    }}</a>
            </li>
            {% endif %}
            {% else %}
            <li class="page-item disabled">
                <a class="page-link" href="#">...</a>
            </li>
            {% endif %}
            {% endfor %}
            {% if pagination.has_next %}
            <li class="page-item">
                <a class="page-link"
                    href="{{ url_for('organization.list_organizations', page=pagination.next_num) }}">Next</a>
            </li>
            <li class="page-item">
                <a class="page-link"
                    href="{{ url_for('organization.list_organizations', page=pagination.pages) }}">Last</a>
            </li>
            {% else %}
            <li class="page-item disabled">
                <a class="page-link" href="#">Next</a>
            </li>
            <li class="page-item disabled">
                <a class="page-link" href="#">Last</a>
            </li>
            {% endif %}
        </ul>
    </nav>
</div>
{% endblock %}