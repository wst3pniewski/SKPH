{% extends "base.jinja" %}

{% block title %}{{ _("Evaluate Task") }}{% endblock %}

{% block content %}
<div class="container mt-2">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h3>{{ _("Evaluate Task") }}</h3>
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title">{{ _("Task Details") }}</h5>
          <hr>
          <p class="card-text"><strong>{{ _("Task") }}:</strong> {{ task.name }}</p>
          <p class="card-text"><strong>{{ _("Volunteer") }}:</strong> {{ task.volunteer.first_name }} {{
            task.volunteer.last_name }}</p>
          <p class="card-text"><strong>{{ _("Task Description") }}:</strong> {{ task.description }}</p>
          <p class="card-text">
            <strong>{{ _("Task Status") }}:</strong>
            {% if task.status == 'completed' %}
            <span class="badge text-bg-success">{{ status_translations[task.status] }}</span>
            {% elif task.status == 'rejected' %}
            <span class="badge text-bg-danger">{{ status_translations[task.status] }}</span>
            {% else %}
            <span class="badge text-bg-info">{{ status_translations[task.status] }}</span>
            {% endif %}
          </p>
        </div>
      </div>
      <form method="post">
        {{ form.hidden_tag() }}
        <fieldset>
          <div class="form-group mb-3">
            {{ form.score.label(class="form-label") }}
            {{ form.score(class="form-select") }}
          </div>
          <div class="form-group mb-3">
            {{ form.description.label(class="form-label") }}
            {{ form.description(class="form-control") }}
          </div>
        </fieldset>
        <div>
          <button type="submit" class="btn btn-primary">{{ _("Evaluate task") }}</button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}