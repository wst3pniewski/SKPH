{% extends "base.jinja" %}

{% block title %}{{ _("Setup Profile Picture") }}{% endblock %}

{% block content %}
<div class="container mt-4">
    <h1>{{ _("Setup Profile Picture") }}</h1>
    <form action="{{ url_for('auth.setup_profile_picture') }}" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label for="file">{{ _("Choose a profile picture") }}</label>
            <input type="file" class="form-control-file" id="file" name="file" required>
        </div>
        <button type="submit" class="btn btn-primary">{{ _("Upload") }}</button>
    </form>
</div>
{% endblock %}