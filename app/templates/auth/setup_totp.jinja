{% extends "base.jinja" %}

{% block title %}{{ _("Setup TOTP") }}{% endblock %}

{% block content %}
<div class="container m-10">
    <h1>{{ _("Setup Two-Factor Authentication") }}</h1>
    <div class="justify-content-center text-center">
        <p>{{ _("Scan the QR code below using an authenticator app (e.g., Google Authenticator)") }}:</p>
        <img class="img-thumbnail d-block mx-auto" height="350" width="350" src="data:image/png;base64,{{ qr_code }}"
            alt="TOTP QR Code">
        <p class="mt-3">{{ _("Or manually enter this secret") }}:
            <strong id="totp_secret">{{ current_user.totp_secret }}</strong>
            <button class="btn btn-outline-secondary btn-sm" onclick="copyToClipboard()">
                <i class="fas fa-copy"></i>
            </button>
        </p>
    </div>
    <form method="post" action="{{ url_for('auth.setup_totp') }}">
        {{ form.hidden_tag() }}
        <div class="form-floating mb-3">
            {{ form.totp_code(class="form-control", placeholder="TOTP Code") }}
            <label for="totp_code">{{ _("Enter OTP Code") }}</label>
        </div>
        <div class="d-flex justify-content-start gap-3 mt-3">
            {{ form.submit(class="btn btn-primary") }}
            <a class="btn btn-secondary" href="{{ url_for('auth.profile') }}">{{ _("Cancel") }}</a>
        </div>
    </form>
</div>

<script>
    function copyToClipboard() {
        var copyText = document.getElementById("totp_secret").innerText;
        navigator.clipboard.writeText(copyText).then(function () {
            alert("Copied to clipboard: " + copyText);
        }, function (err) {
            alert("Failed to copy text: ", err);
        });
    }
</script>
{% endblock %}