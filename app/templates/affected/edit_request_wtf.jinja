{% extends "base.jinja" %}

{% block title %}{{ _("Edit Request") }}{% endblock %}

{% block content %}
<div class="container mt-2">
    <header class="text-center">
        <h1>{{ _("Edit Request") }}</h1>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form action="{{ url_for('affected.edit_request', request_id=request.id) }}" method="post">
                {{ form.hidden_tag() }}
                <div class="form-group mb-3">
                    {{ form.name.label(class="form-label") }}
                    {{ form.name(class="form-control") }}
                </div>
                <div class="form-group mb-3">
                    {{ form.needs.label(class="form-label") }}
                    {{ form.needs(class="form-control") }}
                </div>
                <div class="form-group mb-3">
                    {{ form.amount.label(class="form-label") }}
                    {{ form.amount(class="form-control") }}
                </div>
                <div class="form-group mb-3">
                    {{ form.address.street.label(class="form-label") }}
                    {{ form.address.street(class="form-control") }}
                </div>
                <div class="form-group mb-3">
                    {{ form.address.street_number.label(class="form-label") }}
                    {{ form.address.street_number(class="form-control") }}
                </div>
                <div class="form-group mb-3">
                    {{ form.address.city.label(class="form-label") }}
                    {{ form.address.city(class="form-control") }}
                </div>
                <div class="form-group mb-3">
                    {{ form.address.voivodeship.label(class="form-label") }}
                    {{ form.address.voivodeship(class="form-control") }}
                </div>
                <div class="form-group mb-3">
                    {{ form.charity_campaign_id.label(class="form-label") }}
                    {{ form.charity_campaign_id(class="form-select") }}
                </div>
                <div class="text-center mb-3">
                    <button type="submit" class="btn btn-primary mt-3">{{ _("Save Changes") }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}