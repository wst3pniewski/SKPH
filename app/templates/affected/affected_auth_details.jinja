{% extends "profile.jinja" %}

{% block title %}{{ _("My Details") }}{% endblock %}

<div class="container mt-2">
    <header>
        <h1>{{ affected.first_name }} {{ affected.last_name }}</h1>
    </header>

    {% block specific_user_form %}
    <div class="row">
        <div class="col-md-4">
            <label class="form-label">{{ _("First Name:") }}</label>
            <input type="text" class="form-control" value="{{ affected.first_name }}" readonly>
        </div>
        <div class="col-md-4">
            <label class="form-label">{{ _("Last Name:") }}</label>
            <input type="text" class="form-control" value="{{ affected.last_name }}" readonly>
        </div>
        <div class="col-md-4">
            <label class="form-label">{{ _("Phone") }}</label>
            <input type="tel" class="form-control" value="+1 (555) 123-4567" readonly>
        </div>
    </div>
    <div class="row mt-3">
        <h6 class="mb-3">{{ _("Address Details") }}</h6>
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">{{ _("Street") }}</label>
                <input type="text" class="form-control" value="{{ affected.address.street }}" readonly>
            </div>
            <div class="col-md-6">
                <label class="form-label">{{ _("Street Number") }}</label>
                <input type="text" class="form-control" value="{{ affected.address.street_number }}" readonly>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">{{ _("City") }}</label>
                <input type="text" class="form-control" value="{{ affected.address.city }}" readonly>
            </div>
            <div class="col-md-4">
                <label class="form-label">{{ _("Voivodeship") }}</label>
                <input type="text" class="form-control" value="{{ affected.address.voivodeship }}" readonly>
            </div>
            <div class="col-md-4">
                <label class="form-label">{{ _("ZIP Code") }}</label>
                <input type="text" class="form-control" value="00-001" readonly>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <h6 class="mb-3">{{ _("Needs") }}</h6>
        <div class="col-12">
            <textarea class="form-control" readonly>{{ affected.needs }}</textarea>
        </div>
    </div>
</div>

{% endblock %}


{% block additional_info %}
<section class="mt-4">
    <h2>{{ _("Requests") }}</h2>
    {% if requests %}
    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ _("Request Name") }}</th>
                <th>{{ _("Aid Campaign") }}</th>
                <th>{{ _("Status") }}</th>
                <th>{{ _("Needs") }}</th>
                <th>{{ _("Amount") }}</th>
                <th>{{ _("Address") }}</th>
                <th>{{ _("Actions") }}</th>
            </tr>
        </thead>
        <tbody>
            {% for request in requests %}
            <tr>
                <td>{{ request.name }}</td>
                <td>{{ request.charity_campaign.charity_campaign.name}}</td>
                <td>{{ request.status.value }}</td>
                <td>{{ request.donation_type.type }}</td>
                <td>{{ request.amount }}</td>
                <td>{{ request.address.street }} {{ request.address.street_number }},
                    {{ request.address.city }}, {{ request.address.voivodeship }}</td>
                <td>
                    {% if request.status == RequestStatus.PENDING %}
                    <a href="{{ url_for('affected.edit_request', request_id=request.id) }}"
                        class="btn btn-primary btn-sm">
                        {{ _("Edit") }}
                    </a>
                    <a href="{{ url_for('affected.delete_request', request_id=request.id) }}"
                        class="btn btn-danger btn-sm" onclick="return confirm('{{ _(" Are you sure you want to delete
                        this request?") }}');">
                        {{ _("Delete") }}
                    </a>
                    {% else %}
                    <span class="text-muted">{{ _("Not Editable") }}</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p class="text-muted">{{ _("No requests found.") }}</p>
    {% endif %}
</section>
</div>
{% endblock %}